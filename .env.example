# Copy this file to .env.local and fill in real paths for local transcription.
# .env.local is gitignored; nothing here is committed to the repo.

# --- Local Whisper transcription (Phase 3) -----------------------------
#
# Caption Studio transcribes locally with whisper.cpp (confirmed Phase 0
# decision — see ARCHITECTURE.md §6, §17). Neither the binary nor a model
# is bundled with this repo: they're either multi-MB native binaries or
# multi-hundred-MB model files, and PROJECT.md is explicit that neither
# belongs in version control.
#
# Setup:
#   1. Get a whisper.cpp binary for your platform, either by:
#        - downloading a prebuilt release from
#          https://github.com/ggml-org/whisper.cpp/releases, or
#        - compiling from source (requires a C/C++ toolchain: cmake +
#          a compiler). See the whisper.cpp README for build instructions.
#   2. Download a ggml model (e.g. ggml-base.en.bin) from
#      https://huggingface.co/ggerganov/whisper.cpp/tree/main
#      Start with "tiny" or "base" for development — larger models are
#      slower and use far more disk/RAM with limited V1 benefit.
#   3. Put both somewhere outside the repo, or under a gitignored
#      ./whisper/ directory at the project root (already gitignored).
#   4. Set the two paths below.
#
# Until both are set to real, existing files, the "Generate captions"
# button in the app will fail with a clear setup error — never a fake
# "invalid video" error (Phase 3 brief §2).

WHISPER_BINARY_PATH=
WHISPER_MODEL_PATH=

# Optional. "auto" lets whisper.cpp detect the spoken language.
WHISPER_LANGUAGE=auto

# Optional. Milliseconds before a transcription attempt is killed as
# hung. Defaults to 4 hours — generous because throughput depends
# entirely on your CPU and chosen model size, and a long local
# transcription run is explicitly acceptable in V1 (PROJECT.md §39).
WHISPER_TIMEOUT_MS=
